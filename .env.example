LASSO_API_KEY=
LASSO_TIMEOUT_MS=30000
LASSO_AUDIT_LOG=
MCP_HTTP_HOST=127.0.0.1
MCP_MAX_BODY_BYTES=10485760
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
MCP_HTTP_TOKEN=
# Enable the single write tool (lassox_list_change). Default off.
LASSO_ENABLE_WRITES=false
# Single-user deployments: Lassox user id whose private lists are visible.
LASSO_DEFAULT_USER_ID=
# HTTP behind a trusted gateway: trust X-MCP-User (requires MCP_HTTP_TOKEN).
LASSO_TRUST_FORWARDED_USER=false
# Map gateway emails to Lassox user ids: email=userId,email=userId (or JSON).
LASSO_USER_MAP=
